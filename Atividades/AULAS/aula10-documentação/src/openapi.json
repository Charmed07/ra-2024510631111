{
  "openapi": "3.0.1",
  "info": {
    "title": "API da Biblioteca",
    "description": "API REST para gerenciamento do acervo e empréstimos de uma biblioteca.",
    "contact": {
      "name": "Equipe de Desenvolvimento",
      "email": "dev@biblioteca.exemplo.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Realiza a autenticação e devolve um token JWT válido.",
        "description": "Usuário didático fixo:\r\n            \r\n    POST /api/auth/login\r\n    {\r\n        \"usuario\": \"bibliotecario\",\r\n        \"senha\": \"newton123\"\r\n    }\r\n            \r\nCopie o token retornado e cole no botão \"Authorize\" do Swagger UI.",
        "requestBody": {
          "description": "Credenciais do usuário.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredenciaisRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CredenciaisRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CredenciaisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token gerado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Autores": {
      "get": {
        "tags": [
          "Autores"
        ],
        "summary": "Lista todos os autores cadastrados.",
        "responses": {
          "200": {
            "description": "Retorna a lista de autores.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Autor"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Autores"
        ],
        "summary": "Cadastra um novo autor.",
        "requestBody": {
          "description": "Dados do autor a ser cadastrado.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Autor"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Autor"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Autor"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Autor criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Autor"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Autores/{id}": {
      "get": {
        "tags": [
          "Autores"
        ],
        "summary": "Obtém um autor específico pelo seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do autor.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Autor encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Autor"
                }
              }
            }
          },
          "404": {
            "description": "Autor não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Autores"
        ],
        "summary": "Atualiza os dados de um autor existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do autor a atualizar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Novos dados do autor.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Autor"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Autor"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Autor"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Autor atualizado com sucesso."
          },
          "404": {
            "description": "Autor não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Autores"
        ],
        "summary": "Remove um autor do cadastro.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do autor a ser removido.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Autor removido com sucesso."
          },
          "404": {
            "description": "Autor não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Emprestimos": {
      "get": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Lista todos os empréstimos registrados.",
        "responses": {
          "200": {
            "description": "Lista de empréstimos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Emprestimo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado. Forneça o token Bearer no botão Authorize.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Realiza um novo empréstimo de livro.",
        "description": "O livro deve estar disponível (não emprestado).\r\nO prazo de devolução padrão é de 14 dias.\r\n            \r\nExemplo de requisição:\r\n            \r\n    POST /api/emprestimos\r\n    {\r\n        \"livroId\": 1,\r\n        \"nomeUsuario\": \"João Antonio\"\r\n    }",
        "requestBody": {
          "description": "Dados para o empréstimo.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Emprestimo"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Emprestimo"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Emprestimo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Empréstimo criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Emprestimo"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Livro não encontrado ou já emprestado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Emprestimos/{id}": {
      "get": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Obtém um empréstimo específico por ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador do empréstimo.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Empréstimo encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Emprestimo"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Empréstimo não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Emprestimos/{id}/devolver": {
      "patch": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Registra a devolução de um livro emprestado.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do empréstimo a ser devolvido.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Livro devolvido com sucesso."
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Empréstimo não encontrado ou já devolvido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Livros": {
      "get": {
        "tags": [
          "Livros"
        ],
        "summary": "Lista os livros do acervo com paginação.",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "description": "Número da página (a partir de 1).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamanhoPagina",
            "in": "query",
            "description": "Itens por página (máximo 50).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de livros com metadados de paginação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivroRespostaPaginada"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Livros"
        ],
        "summary": "Cadastra um novo livro no acervo.",
        "description": "Exemplo de requisição:\r\n            \r\n    POST /api/livros\r\n    {\r\n        \"titulo\": \"Dom Casmurro\",\r\n        \"genero\": \"Romance\",\r\n        \"anoPublicacao\": 1899,\r\n        \"autorId\": 1\r\n    }",
        "requestBody": {
          "description": "Dados do livro.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Livro"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Livro"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Livro"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Livro criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Livro"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Livros/{id}": {
      "get": {
        "tags": [
          "Livros"
        ],
        "summary": "Obtém um livro pelo seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do livro.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Livro encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Livro"
                }
              }
            }
          },
          "404": {
            "description": "Livro não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Livros"
        ],
        "summary": "Atualiza um livro existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do livro a atualizar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Novos dados do livro.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Livro"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Livro"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Livro"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Atualizado com sucesso."
          },
          "404": {
            "description": "Livro não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Livros"
        ],
        "summary": "Remove um livro do acervo.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do livro a remover.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removido com sucesso."
          },
          "404": {
            "description": "Livro não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Livros/buscar": {
      "get": {
        "tags": [
          "Livros"
        ],
        "summary": "Busca livros por título, gênero e/ou autor.",
        "parameters": [
          {
            "name": "titulo",
            "in": "query",
            "description": "Trecho do título.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genero",
            "in": "query",
            "description": "Gênero exato.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "autorId",
            "in": "query",
            "description": "ID do autor.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista (possivelmente vazia) de livros encontrados.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Livro"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Autor": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único do autor.",
            "format": "int32",
            "example": 1
          },
          "nome": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string",
            "description": "Nome completo do autor.",
            "example": "Machado de Assis"
          },
          "pais": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "País de origem do autor.",
            "nullable": true,
            "example": "Brasil"
          },
          "biografia": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "description": "Breve resumo biográfico do autor.",
            "nullable": true,
            "example": "Considerado um dos maiores nomes da literatura brasileira."
          },
          "livros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Livro"
            },
            "description": "Lista de livros associados a este autor.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Representa um autor de livros no acervo da biblioteca."
      },
      "CredenciaisRequest": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "string",
            "description": "Nome de usuário (ex: bibliotecario).",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "description": "Senha de acesso (ex: newton123).",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Credenciais para autenticação no sistema."
      },
      "Emprestimo": {
        "required": [
          "livroId",
          "nomeUsuario"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único do registro de empréstimo.",
            "format": "int32",
            "example": 1
          },
          "livroId": {
            "type": "integer",
            "description": "Identificador do livro emprestado.",
            "format": "int32",
            "example": 1
          },
          "nomeUsuario": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Nome do usuário que realizou o empréstimo.",
            "example": "João Antonio"
          },
          "dataEmprestimo": {
            "type": "string",
            "description": "Data e hora em que o empréstimo foi iniciado (UTC).",
            "format": "date-time",
            "example": "2026-10-24T20:00:00Z"
          },
          "dataDevolucaoPrevista": {
            "type": "string",
            "description": "Data limite para devolução do exemplar (padrão de 14 dias).",
            "format": "date-time",
            "example": "2026-11-07T20:00:00Z"
          },
          "dataDevolucaoEfetiva": {
            "type": "string",
            "description": "Data e hora em que a devolução foi confirmada (nula enquanto ativo).",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/StatusEmprestimo"
          }
        },
        "additionalProperties": false,
        "description": "Representa o empréstimo de um livro para um usuário da biblioteca."
      },
      "Livro": {
        "required": [
          "autorId",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único do livro.",
            "format": "int32",
            "example": 1
          },
          "titulo": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string",
            "description": "Título da obra.",
            "example": "Dom Casmurro"
          },
          "isbn": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Código ISBN internacional do livro.",
            "nullable": true,
            "example": "978-85-359-0277-5"
          },
          "anoPublicacao": {
            "maximum": 2100,
            "minimum": 1000,
            "type": "integer",
            "description": "Ano em que a obra foi publicada.",
            "format": "int32",
            "example": 1899
          },
          "genero": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Gênero literário da obra.",
            "nullable": true,
            "example": "Romance"
          },
          "autorId": {
            "type": "integer",
            "description": "Identificador do autor responsável pela obra.",
            "format": "int32",
            "example": 1
          },
          "disponivel": {
            "type": "boolean",
            "description": "Indica se o exemplar está disponível para novos empréstimos.",
            "example": true
          }
        },
        "additionalProperties": false,
        "description": "Representa um livro no acervo da biblioteca."
      },
      "LivroRespostaPaginada": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Livro"
            },
            "description": "Coleção dos itens da página corrente.",
            "nullable": true
          },
          "pagina": {
            "type": "integer",
            "description": "Número da página retornada.",
            "format": "int32",
            "example": 1
          },
          "tamanhoPagina": {
            "type": "integer",
            "description": "Quantidade máxima de itens por página.",
            "format": "int32",
            "example": 10
          },
          "totalItens": {
            "type": "integer",
            "description": "Total geral de itens existentes em todas as páginas.",
            "format": "int32",
            "example": 25
          },
          "totalPaginas": {
            "type": "integer",
            "description": "Total de páginas calculadas.",
            "format": "int32",
            "readOnly": true,
            "example": 3
          }
        },
        "additionalProperties": false,
        "description": "Envelope de resposta com metadados para consultas paginadas."
      },
